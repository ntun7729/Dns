worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events { worker_connections 1024; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    sendfile on;
    keepalive_timeout 65;
    client_max_body_size 64m;
    client_body_temp_path /tmp/nginx-client;
    proxy_temp_path /tmp/nginx-proxy;

    server {
        listen __PORT__ default_server;
        server_name _;

        location = /_healthz {
            proxy_pass http://127.0.0.1:9080/_healthz;
            proxy_http_version 1.1;
        }

        location /_bridge/ {
            proxy_pass http://127.0.0.1:9080;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_request_buffering off;
            proxy_buffering off;
        }

        location = /_bridge {
            return 302 /_bridge/;
        }

        # Optional DoH bridge. Enable DNS-over-HTTP on port 8053 in Technitium.
        # Render/Railway terminates HTTPS, then nginx forwards the DNS wire-format
        # request to Technitium over localhost HTTP.
        location = /dns-query {
            proxy_pass http://127.0.0.1:8053/dns-query;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_request_buffering off;
            proxy_buffering off;
        }

        location / {
            proxy_pass http://127.0.0.1:5380;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_buffering off;
        }
    }
}
