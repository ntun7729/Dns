worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events { worker_connections 1024; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    sendfile on;
    keepalive_timeout 65;
    client_max_body_size 64m;
    client_body_temp_path /tmp/nginx-client;
    proxy_temp_path /tmp/nginx-proxy;

    upstream technitium_web {
        server 127.0.0.1:5380 max_fails=1 fail_timeout=1s;
        __TECH_WEB_BACKUP__
    }

    upstream technitium_doh {
        server 127.0.0.1:__TECH_DOH_HTTP_PORT__ max_fails=1 fail_timeout=1s;
        __TECH_DOH_BACKUP__
    }

    server {
        listen __PORT__ default_server;
        __FIXED_LISTEN__
        server_name _;

        # Railway health checks only need to prove that the public nginx
        # frontend is accepting HTTP. The entrypoint separately terminates the
        # container if Technitium or the bridge process exits.
        location = /_healthz {
            default_type application/json;
            return 200 '{"ok":true,"frontend":"nginx"}';
        }

        location /_bridge/ {
            proxy_pass http://127.0.0.1:9080;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_request_buffering off;
            proxy_buffering off;
        }

        location = /_bridge {
            return 302 /_bridge/;
        }

        location = /dns-query {
            proxy_pass http://technitium_doh/dns-query;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_request_buffering off;
            proxy_buffering off;
        }

        location / {
            proxy_pass http://technitium_web;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_next_upstream error timeout http_502 http_503 http_504;
            proxy_buffering off;
        }
    }
}
