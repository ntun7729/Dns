# DNS Dashboard v4 does not require operational configuration in Docker/Render
# environment variables. Configure DNS, FRPC, TLS, filtering, profiles, and
# dashboard credentials from the web Settings page.

# Process/bootstrap values only:
APP_ENV=production
PORT=10000
BIND_HOST=0.0.0.0

# Existing deployments that already have legacy DNS/FRP/TLS environment
# variables are migrated into dashboard storage on first start. After migration,
# the persisted dashboard configuration is authoritative and those variables do
# not need to be edited again.
