SERVICE_NAME=DNS Dashboard
APP_ENV=development
PORT=10000
BIND_HOST=0.0.0.0

# Set both values to protect the dashboard and enable profile controls.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# Bounded aggregate history. Queried domains and client IPs are not retained.
HISTORY_MINUTES=120

DOT_ENABLED=true
DOT_BIND_HOST=127.0.0.1
DOT_PORT=8853
DOT_PUBLIC_HOSTNAME=dns-dashboard.local
DOT_CERT_FILE=/tmp/dns-dashboard/tls.crt
DOT_KEY_FILE=/tmp/dns-dashboard/tls.key
# Production Render secrets. Prefer single-line base64 values.
DOT_CERT_B64=
DOT_KEY_B64=
# Legacy multiline PEM values remain supported.
DOT_CERT_PEM=
DOT_KEY_PEM=

# Comma/newline-separated host:port resolvers. Bracket explicit IPv6 ports.
UPSTREAM_DNS_SERVERS=1.1.1.1:53,9.9.9.9:53,8.8.8.8:53
UPSTREAM_STRATEGY=primary_failover
UPSTREAM_TIMEOUT_SECONDS=2.0
# Failed resolvers are skipped temporarily, then retried automatically.
RESOLVER_COOLDOWN_SECONDS=15
RESOLVER_COOLDOWN_MAX_SECONDS=120
# Legacy fallback used only when UPSTREAM_DNS_SERVERS is empty.
UPSTREAM_DNS=1.1.1.1
UPSTREAM_DNS_PORT=53

# Initial values for the default in-memory profile.
FILTER_ENABLED=false
BLOCKLIST_PRESET=hagezi_light
FILTER_UPDATE_HOURS=24
# One HTTPS raw.githubusercontent.com URL per line, maximum five.
CUSTOM_BLOCKLIST_URLS=
MANUAL_BLOCK_DOMAINS=
ALLOW_DOMAINS=

FRPC_ENABLED=false
FRP_SERVER_ADDR=203.0.113.10
FRP_SERVER_PORT=7000
FRP_REMOTE_PORT=853
# Optional; leave empty when FRPS uses no token authentication.
FRP_AUTH_TOKEN=
